# The reviewed recipe digest is byte-exact on Windows CI and local checkouts.
MONO/launcher/build_ffmpeg_windows.py text eol=lf
# Preserve upstream notice bytes, including their original mixed line endings.
MONO/launcher/licenses/** -text

# One-click installers: cmd/ps1 need CRLF for Windows; shell scripts need LF.
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.command text eol=lf
*.sh text eol=lf

# «Code → Download ZIP» holds only what a person needs: the installer and the MONO folder.
# (GitHub builds that archive like `git archive`, which leaves out export-ignore paths.)
.github export-ignore
.gitattributes export-ignore
.gitignore export-ignore
README.md export-ignore
MONO/tests export-ignore
MONO/docs export-ignore
MONO/.dockerignore export-ignore
MONO/.env.example export-ignore
