{
  "name": "mono-transcribe",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "description": "Локальная SPA/PWA для записи и русской транскрибации",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test",
    "check": "node scripts/check-syntax.mjs",
    "smoke": "node --test tests/proxy.test.mjs",
    "launcher:smoke": "python3 launcher/mono_launcher.py --dev --smoke",
    "launcher:test": "cd launcher && python3 -m unittest discover -s tests -v",
    "test:e2e": "node --test tests/e2e/*.e2e.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
