# Replace example.com with an actual DNS name that points to this server.
MONO_DOMAIN=mono.example.com
ACME_EMAIL=operator@example.com
MONO_BASIC_USER=operator
# Generate: docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'YOUR_LONG_PASSWORD'
# Single-quote hash to avoid $ expansion by dotenv parsers.
MONO_BASIC_HASH='$2a$14$REPLACE_WITH_HASH_FROM_CADDY'
MONO_MAX_UPLOAD_BYTES=1073741824
MONO_JOB_TTL_HOURS=168
